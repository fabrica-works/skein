#!/bin/sh
set -eu
if [ "$#" -ne 1 ]; then
    echo 'usage: repository DIR' >&2
    exit 2
fi
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")/source" && pwd)
mkdir -p -- "$1"
for entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    if [ -e "$entry" ] || [ -L "$entry" ]; then
        echo 'repository: DIR must be empty' >&2
        exit 2
    fi
done
cp -- "$source_dir/README.md" "$1/README.md"
chmod 0644 "$1/README.md"
cd -- "$1"
exec env -i PATH=/usr/bin:/bin GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
    GIT_AUTHOR_NAME=lab GIT_AUTHOR_EMAIL=lab@invalid \
    GIT_COMMITTER_NAME=lab GIT_COMMITTER_EMAIL=lab@invalid \
    GIT_AUTHOR_DATE=2026-10-23T00:00:00Z GIT_COMMITTER_DATE=2026-10-23T00:00:00Z \
    /bin/sh -eu -c '
        git -c core.hooksPath=/dev/null init -q --template= --object-format=sha1 --initial-branch=main
        git -c core.autocrlf=false add -- README.md
        git -c core.hooksPath=/dev/null -c commit.gpgSign=false commit -q -m "ledger source"
        git rev-parse HEAD
    '
