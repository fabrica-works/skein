family lint-fixture 1

record HostTool {
    inspect: bool
    modify: bool
    shell: bool
    agents: bool
    max_tokens: u32
    payload: bytes 10000
}

record Boundless {
    count: u32
}

record Payload {
    data: bytes 4
}

record OtherPayload {
    value: u8
}

enum Shared {
    first: Payload
    second: Payload
    other: OtherPayload
    empty
}

record OneByteItems {
    items: list 4 Shared
}

record OptionalPayload {
    data: option bytes 4
}

enum BoxedChoice {
    payload: boxed OptionalPayload
    inline: OptionalPayload
    empty
}

enum InlineChoice {
    payload: OptionalPayload
    empty
}

record FixedWidthItems {
    wide: list 4 u64
    narrow: list 4 u32
}

record LongRecord {
    alpha: bytes 4
    bravo: bytes 4
    charlie: bytes 4
    delta: bytes 4
